{
    "name": "darthsoup/php-whmcs-api",
    "description": "WHMCS API client for PHP",
    "keywords": ["whmcs", "api"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin Krummnacker",
            "email": "kevin.krummnacker@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^2.0",
        "php-http/client-common": "^2.6",
        "php-http/discovery": "^1.17",
        "php-http/httplug": "^2.4",
        "symfony/options-resolver": "^6.0 || ^7.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "http-interop/http-factory-guzzle": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "DarthSoup\\WhmcsApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DarthSoup\\Tests\\WhmcsApi\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
